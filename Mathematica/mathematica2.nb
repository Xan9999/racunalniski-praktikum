Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"k", ",", " ", "n"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"3", " ", "==", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "2"}], " ", "k"}], " ", "+", " ", "n"}]}], " ", "&&", " ", 
    RowBox[{
     RowBox[{"-", "1"}], " ", "==", " ", 
     RowBox[{
      RowBox[{"6", "k"}], "+", "n"}]}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"k", ",", " ", "n"}], "}"}], ",", " ", "Reals"}], "]"}]}], "Input",
