       RowBox[{"2", "n"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"n", ",", " ", "1", ",", " ", "k"}], "}"}]}], "]"}], " ", "==",
     " ", "36"}], ",", " ", 
   RowBox[{"{", "k", "}"}]}], "]"}]}], "Input",
