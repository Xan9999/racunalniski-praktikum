Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "x", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"x", "^", "2"}], " ", "-", " ", "1"}], ")"}], "/", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"x", "^", "2"}], " ", "-", " ", "4"}], 
    ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", 
     RowBox[{"-", "5"}], ",", " ", "5"}], "}"}], ",", "\[IndentingNewLine]", 
   StyleBox[
    RowBox[{"ExclusionsStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"Dashed", ",", "Red"}], "}"}], "}"}]}], "Code"]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nicle", " ", "=", " ", 
   RowBox[{"x", " ", "/.", " ", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"f", "[", "x", "]"}], " ", "==", " ", "0"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"poli", " ", "=", " ", 
  RowBox[{"x", " ", "/.", " ", 
   RowBox[{"Solve", "[", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Denominator", "[", 
       RowBox[{"f", "[", "x", "]"}], "]"}], " ", "==", " ", "0"}], ",", " ", 
     "x"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"Limit", "[", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], ",", " ", 
   RowBox[{"x", " ", "->", " ", 
    RowBox[{"poli", "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
   RowBox[{"Direction", "->", "1"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Limit", "[", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], ",", " ", 
   RowBox[{"x", " ", "->", " ", "Infinity"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"stacionarne", " ", "=", " ", 
  RowBox[{"x", " ", "/.", " ", 
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"f", "'"}], "[", "x", "]"}], " ", "==", " ", "0"}], 
    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"konveksnost", " ", "=", " ", 
  RowBox[{"Reduce", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"f", "''"}], "[", "x", "]"}], " ", ">", " ", "0"}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.945780915994196*^9, 3.945781239844557*^9}, {
