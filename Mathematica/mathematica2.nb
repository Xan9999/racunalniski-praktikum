 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"Cos", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"3", " ", "-", " ", "x"}], ")"}], 
        RowBox[{"Sin", "[", "x", "]"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"x", " ", "+", " ", "1"}], ")"}]}], "]"}], 
