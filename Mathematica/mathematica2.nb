Cell[TextData[{
 "Dolo\[CHacek]i vsa realna \[SHacek]tevila, ki zado\[SHacek]\[CHacek]ajo \
neena\[CHacek]bi  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"|", 
      RowBox[{"x", "-", "3"}], "|"}], 
     RowBox[{"x", "+", "1"}]], ">", 
    SqrtBox[
     RowBox[{"3", "-", 
      RowBox[{"2", "x"}]}]]}], TraditionalForm]],ExpressionUUID->
  "ce67004d-9465-4271-9bf8-7a5b57affd8d"]
