Cell[TextData[{
 "V dokumentaciji poi\[SHacek]\[CHacek]ite funkcijo ",
 StyleBox["Derivative", "Code"],
 " in njeni okraj\[SHacek]avi ",
 StyleBox["D", "Code"],
 " in ",
 StyleBox["\[OpenCurlyQuote]", "Code"],
 ".\[LineSeparator]Uporabite jo, da izra\[CHacek]unate:\n1. prvi in drugi \
odvod funkcije ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", "arctan", " "}], TraditionalForm]],ExpressionUUID->
  "e4517c8b-7712-4ff1-bd6f-201ecb6323df"],
 ",\n2. prvi odvod funkcije ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RadicalBox[
     RowBox[{
      RowBox[{"3", "x"}], "-", "2"}], "3"], 
    SqrtBox[
     RowBox[{
      RowBox[{"2", "x"}], "+", "1"}]]], TraditionalForm]],ExpressionUUID->
  "0f832ba9-1c86-4f9e-9ff0-e4c1dc0a643a"],
 ",\n\[CapitalCHacek]e ste v eni od prej\[SHacek]njih nalog dolo\[CHacek]ili \
